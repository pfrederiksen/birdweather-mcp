# Optional: enables station REST API for richer detection/stats fields.
# Never commit the real token. The server never logs or echoes it.
# BIRDWEATHER_STATION_TOKEN=

# Optional: public station id for live pytest smoke (pytest -m live).
# Prefer setting this only in the shell, not committing a personal station id.
# BIRDWEATHER_TEST_STATION_ID=

# Optional HTTP transport overrides (default is stdio)
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=8000

# Comma-separated Host header values for streamable-HTTP (DNS rebinding protection).
# Default (unset): loopback only. Use hostname:* for MagicDNS/LAN names.
# Set to * to allow any host (trusted networks only).
# MCP_ALLOWED_HOSTS=nas.example.local:*,192.168.1.10:*
# MCP_ALLOWED_HOSTS=*

# In-memory upstream response cache (GraphQL + REST). TTL 0 or ENABLED=false disables.
# BIRDWEATHER_CACHE_TTL=60
# BIRDWEATHER_CACHE_MAX_ENTRIES=256
# BIRDWEATHER_CACHE_ENABLED=true

# Retries with exponential backoff + jitter on 429/5xx/timeouts (default 5).
# BIRDWEATHER_MAX_RETRIES=5

# Optional bearer token for HTTP /mcp (not /health). Never commit the real value.
# MCP_AUTH_TOKEN=
